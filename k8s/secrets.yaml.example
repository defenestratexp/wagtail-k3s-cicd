# Secrets for the resume-site namespace. Copy to secrets.yaml (git-ignored),
# fill in real values, and apply before postgres.yaml / wagtail.yaml:
#   kubectl apply -f k8s/secrets.yaml
# Generate a Django key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: resume-site
type: Opaque
stringData:
  POSTGRES_DB: resume_site
  POSTGRES_USER: wagtail
  POSTGRES_PASSWORD: CHANGE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: wagtail-secret
  namespace: resume-site
type: Opaque
stringData:
  DJANGO_SECRET_KEY: CHANGE_ME
  POSTGRES_PASSWORD: CHANGE_ME   # must match postgres-secret
